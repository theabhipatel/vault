# ---- Vault API settings --------------------------------------------------------------
# Copy to .env and adjust. Every setting also works as a plain environment variable.

# development | test | production  (production hides /api/docs and the OpenAPI schema)
ENVIRONMENT=development

# Public origin of the web app (the browser's address). Used for email links, the
# CSRF Origin check, CORS and the Google OAuth redirect URI.
APP_URL=http://localhost:29180
APP_NAME="Secure Vault"

DATABASE_URL=postgresql+asyncpg://vault:vault@localhost:29432/vault
DATABASE_ECHO=false

# Signs short-lived OAuth state cookies. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to true whenever the app is served over HTTPS (required in production).
# Enables Secure + __Host- cookies and HSTS.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7

# SMTP. Development uses Mailpit from docker-compose (web UI: http://localhost:29825).
SMTP_HOST=localhost
SMTP_PORT=29025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TLS=false
MAIL_FROM="Secure Vault <no-reply@vault.local>"
EMAIL_WORKER_ENABLED=true

# Google sign-in (optional). Create an OAuth client of type "Web application" and add
# the authorised redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_DAYS=7

# Rate limits
SIGNIN_IP_LIMIT=30
SIGNIN_EMAIL_FAILURE_LIMIT=5
SIGNIN_WINDOW_MINUTES=15
EMAIL_ACTION_LIMIT=5
EMAIL_ACTION_WINDOW_MINUTES=30
TOKEN_SUBMIT_IP_LIMIT=30

MAX_AVATAR_BYTES=1000000
